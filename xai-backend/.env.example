PROJECT_NAME=xai-backend
API_V1_STR=/api/v1
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000","https://smartshop.chqme.com"]

# Database Configuration
DB_TYPE: str = "postgresql"
DB_HOST: str = "your-db-host"
DB_PORT: int = 5432
DB_NAME: str = "your-db-name"
DB_USER: str = "your-db-user"
DB_PASSWORD: str = "your-db-password"
REFRESH_INTERVAL: int = 30
CACHE_TTL: int = 60
SSL_MODE: str = "disable"
ENV: str = "dev"

# AWS / S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-south-1
BUCKET_NAME_1=chqme-ai-agent
TRANSCRIPT_FOLDER_NAME_1=transcripts/
TRANSCRIPT_UPLOAD_ENABLED=false

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=chqme